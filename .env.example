# PostgreSQL (Neon)
# Pooled URL for the app runtime (lib/db) — hostname includes "-pooler"
DATABASE_URL=
# Direct URL for Prisma CLI (db push, migrate, studio) — no "-pooler" in hostname
DATABASE_URL_UNPOOLED=
# Alias for DATABASE_URL_UNPOOLED (optional)
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (Better Auth social provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (install + repo access)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Paste the full .pem from GitHub, or base64 body with \n line breaks.
# On Vercel, prefer the full PEM including -----BEGIN RSA PRIVATE KEY----- headers.
GITHUB_WEBHOOK_SECRET=
GITHUB_STATE_SECRET=
